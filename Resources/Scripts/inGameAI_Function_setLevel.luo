






function inGameAI.setLevel(level)






this.level(level)

local l=this.levelValues()
hashtable.empty(l)

hashtable.add(l,"background","bg"..string.format("%02d",level))

local prefix=""

























if(level==1)then
hashtable.add(l,"music","musicD")
hashtable.add(l,"timeStep",2)
hashtable.add(l,"goodPercentage",60)
hashtable.add(l,"latForceMin",1)
hashtable.add(l,"latForceMax",1)
hashtable.add(l,"latFreqMin",0.5)
hashtable.add(l,"latFreqMax",0.5)
hashtable.add(l,"dampingMin",15)
hashtable.add(l,"dampingMax",35)
hashtable.add(l,"prizeStep",10)
object.sendEvent(this.player(),"playerAI","onSetSensor",-0.2,0,0,0.15)
prefix="bug"
elseif(level==2)then
hashtable.add(l,"music","musicE")
hashtable.add(l,"timeStep",2)
hashtable.add(l,"goodPercentage",45)
hashtable.add(l,"latForceMin",1)
hashtable.add(l,"latForceMax",2)
hashtable.add(l,"latFreqMin",0.5)
hashtable.add(l,"latFreqMax",2)
hashtable.add(l,"dampingMin",5)
hashtable.add(l,"dampingMax",25)
hashtable.add(l,"prizeStep",10)
object.sendEvent(this.player(),"playerAI","onSetSensor",-0.2,0,0,0.2)
prefix="cloud"
elseif(level==3)then
hashtable.add(l,"music","musicF")
hashtable.add(l,"timeStep",1.5)
hashtable.add(l,"goodPercentage",30)
hashtable.add(l,"latForceMin",1)
hashtable.add(l,"latForceMax",3)
hashtable.add(l,"latFreqMin",1)
hashtable.add(l,"latFreqMax",3)
hashtable.add(l,"dampingMin",2)
hashtable.add(l,"dampingMax",10)
hashtable.add(l,"prizeStep",10)
object.sendEvent(this.player(),"playerAI","onSetSensor",-0.15,0,0,0.2)
prefix="cat"
elseif(level==4)then
hashtable.add(l,"music","musicG")
hashtable.add(l,"timeStep",0.5)
hashtable.add(l,"goodPercentage",20)
hashtable.add(l,"latForceMin",1)
hashtable.add(l,"latForceMax",2)
hashtable.add(l,"latFreqMin",1)
hashtable.add(l,"latFreqMax",2)
hashtable.add(l,"dampingMin",2)
hashtable.add(l,"dampingMax",8)
hashtable.add(l,"prizeStep",10)
object.sendEvent(this.player(),"playerAI","onSetSensor",0.2,0,0,0.2)
prefix="hugg"
end














local p=this.player()
object.sendEvent(p,"animAI","onStop")
object.sendEvent(p,"animAI","onClearAnims")
object.sendEvent(p,"animAI","onAddAnim","normal",prefix.."_happy_normal_",17,25)
object.sendEvent(p,"animAI","onAddAnim","normal_smile",prefix.."_happy_smile_",17,25,"normal")
object.sendEvent(p,"animAI","onAddAnim","normal_hit",prefix.."_happy_hit_",17,25,"normal")
object.sendEvent(p,"animAI","onAddAnim","normal_downgrade",prefix.."_happy_downgrade_",17,25,"enfado")
object.sendEvent(p,"animAI","onAddAnim","enfado",prefix.."_angry_normal_",17,25)
object.sendEvent(p,"animAI","onAddAnim","enfado_smile",prefix.."_angry_smile_",17,25,"enfado")
object.sendEvent(p,"animAI","onAddAnim","enfado_hit",prefix.."_angry_hit_",17,25,"enfado")
object.sendEvent(p,"animAI","onAddAnim","enfado_downgrade",prefix.."_angry_downgrade_",17,25,"muyenfado")
object.sendEvent(p,"animAI","onAddAnim","enfado_upgrade",prefix.."_angry_upgrade_",17,25,"normal")
object.sendEvent(p,"animAI","onAddAnim","muyenfado",prefix.."_veryangry_normal_",17,25)
object.sendEvent(p,"animAI","onAddAnim","muyenfado_smile",prefix.."_veryangry_smile_",17,25,"muyenfado")
object.sendEvent(p,"animAI","onAddAnim","muyenfado_hit",prefix.."_veryangry_hit_",17,25,"muyenfado")
object.sendEvent(p,"animAI","onAddAnim","muyenfado_upgrade",prefix.."_veryangry_upgrade_",17,25,"enfado")

object.sendEvent(p,"animAI","onSetAnim","normal")
object.sendEvent(p,"animAI","onPlay")
object.setVisible(p,false)

this.sPrefix(prefix)



end
